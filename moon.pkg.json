{
  "is-main": false,
  "supported-targets": ["native"],
  "import": [
    { "path": "moonbitlang/core/encoding/utf8", "alias": "utf8" }
  ],
  "targets": {
    "postgres.mbt": ["native"],
    "postgres_c.c": ["native"]
  },
  "native-stub": ["postgres_c.c"],
  "link": {
